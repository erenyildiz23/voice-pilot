# mock: çevrimdışı, ses yerine metin taşır. elevenlabs: gerçek servis.
PROVIDER=mock
# Ses ucu varsayılan kapalı. Açmadan önce docs/01-kesif-notu.md soru 1'i cevaplat.
ALLOW_CLOUD_AUDIO=false
