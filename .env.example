# mock: offline, carries text instead of audio. elevenlabs: the live service.
PROVIDER=mock
# The audio endpoint is off by default. Answer question 1 in docs/01-discovery-note.md before turning it on.
ALLOW_CLOUD_AUDIO=false
AUDIT_LOG_PATH=audit.jsonl

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_LANGUAGE=
# Demo: PIN entry for balance + made-up account data. Keep it off in a real customer environment.
MOCK_BANKING=false
